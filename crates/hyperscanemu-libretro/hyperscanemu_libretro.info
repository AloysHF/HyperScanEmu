# Optional firmware (fixed, case-sensitive names below <system>/hyperscanemu/).
# Without them the core boots through its HLE path; gameplay may still need
# firmware-resident services, so the dumped firmware remains recommended.
firmware0_path = "hyperscanemu/spg290.bin"
firmware0_desc = "SPG290 internal ROM (32768 bytes)"
firmware0_opt = "true"
firmware1_path = "hyperscanemu/hyperscan.bin"
firmware1_desc = "HyperScan BIOS (1048576 bytes)"
firmware1_opt = "true"

notes = "(!) Firmware file names are case-sensitive and must stay spg290.bin and hyperscan.bin.|(!) Firmware is optional: with both files the core boots LLE through the real BIOS; without them it boots HLE directly into the game.|(!) The internal ROM must be 32768 bytes and the BIOS 1048576 bytes."
description = "HyperScanEmu is an evidence-driven, clean-room emulator for the Mattel HyperScan (Sunplus SPG290). This libretro core loads BIN/CUE/ZIP disc packages and uses legally dumped firmware when present."
